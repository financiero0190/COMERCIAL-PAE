<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Moto Morini X-Cape 1000 — Campaña Expectativa</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Bebas+Neue&family=Montserrat:wght@200;300;400;700;900&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --nero: #080808;
    --rosso: #C8102E;
    --oro: #B8973A;
    --bianco: #F0EDE8;
    --grigio: #1A1A1A;
    --grigio-mid: #2E2E2E;
  }

  body {
    background: #0a0a0a;
    font-family: 'Montserrat', sans-serif;
    color: var(--bianco);
    overflow-x: hidden;
  }

  /* ── HEADER NAV ── */
  .studio-nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 48px;
    background: linear-gradient(to bottom, rgba(8,8,8,0.95), transparent);
  }
  .studio-nav .brand {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 13px;
    letter-spacing: 4px;
    color: var(--oro);
    opacity: 0.8;
  }
  .studio-nav .label {
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(240,237,232,0.4);
  }

  /* ── HERO INTRO ── */
  .hero-intro {
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    background: var(--nero);
  }
  .hero-intro::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 50% at 50% 60%, rgba(200,16,46,0.08) 0%, transparent 70%);
  }
  .noise-overlay {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.035'/%3E%3C/svg%3E");
    opacity: 0.4;
    pointer-events: none;
  }
  .hero-year {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(120px, 20vw, 280px);
    color: rgba(184,151,58,0.06);
    position: absolute;
    bottom: -20px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    letter-spacing: -5px;
    pointer-events: none;
  }
  .hero-content {
    text-align: center;
    position: relative;
    z-index: 2;
    animation: fadeUp 1.2s ease both;
  }
  .hero-eagle {
    width: 90px;
    margin: 0 auto 32px;
    opacity: 0;
    animation: fadeUp 1s 0.3s ease both;
  }
  .hero-eagle svg { width: 100%; }
  .hero-tagline {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(14px, 1.8vw, 20px);
    font-style: italic;
    letter-spacing: 6px;
    color: var(--oro);
    text-transform: uppercase;
    margin-bottom: 20px;
    opacity: 0;
    animation: fadeUp 1s 0.5s ease both;
  }
  .hero-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(52px, 8vw, 110px);
    line-height: 0.9;
    letter-spacing: 2px;
    color: var(--bianco);
    opacity: 0;
    animation: fadeUp 1s 0.7s ease both;
  }
  .hero-title span { color: var(--rosso); }
  .hero-sub {
    margin-top: 28px;
    font-size: 11px;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: rgba(240,237,232,0.35);
    opacity: 0;
    animation: fadeUp 1s 1s ease both;
  }
  .scroll-hint {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0;
    animation: fadeUp 1s 1.4s ease both;
  }
  .scroll-hint span { font-size: 9px; letter-spacing: 4px; color: rgba(240,237,232,0.3); }
  .scroll-line {
    width: 1px; height: 50px;
    background: linear-gradient(to bottom, var(--oro), transparent);
    animation: pulse 2s infinite;
  }

  /* ── SECTION LABEL ── */
  .section-label {
    text-align: center;
    padding: 80px 0 16px;
  }
  .section-label p {
    font-size: 9px;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: var(--oro);
  }
  .section-label h2 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(28px, 4vw, 48px);
    letter-spacing: 3px;
    color: rgba(240,237,232,0.08);
    margin-top: 4px;
  }

  /* ── PIECES GRID ── */
  .pieces-section {
    padding: 20px 40px 80px;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* ── PIEZA 1: APERTURA NEGRO ── */
  .pieza {
    margin-bottom: 60px;
    position: relative;
  }
  .pieza-tag {
    font-size: 9px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--oro);
    margin-bottom: 12px;
    padding-left: 4px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .pieza-tag::before {
    content: '';
    display: block;
    width: 24px; height: 1px;
    background: var(--rosso);
  }

  .card-apertura {
    aspect-ratio: 16/9;
    background: #050505;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(184,151,58,0.08);
  }
  .card-apertura::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 40% 40% at 50% 50%, rgba(200,16,46,0.05) 0%, transparent 70%);
  }
  .apertura-lines {
    position: absolute;
    inset: 0;
    background-image: 
      repeating-linear-gradient(0deg, transparent, transparent 59px, rgba(184,151,58,0.03) 60px),
      repeating-linear-gradient(90deg, transparent, transparent 59px, rgba(184,151,58,0.03) 60px);
  }
  .apertura-content {
    text-align: center;
    position: relative;
    z-index: 2;
  }
  .apertura-eagle {
    margin: 0 auto 32px;
    width: 80px;
    opacity: 0.9;
  }
  .apertura-copy {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(18px, 2.5vw, 32px);
    font-weight: 300;
    font-style: italic;
    line-height: 1.7;
    color: rgba(240,237,232,0.75);
    letter-spacing: 1px;
  }
  .apertura-copy strong {
    display: block;
    font-family: 'Bebas Neue', sans-serif;
    font-style: normal;
    font-size: clamp(28px, 4vw, 54px);
    color: var(--bianco);
    letter-spacing: 4px;
    margin-top: 8px;
    font-weight: 400;
  }
  .apertura-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--rosso);
    margin: 24px auto 0;
    box-shadow: 0 0 16px rgba(200,16,46,0.6);
  }

  /* ── PIEZA 2: HERITAGE REEL ── */
  .card-heritage {
    aspect-ratio: 9/16;
    max-height: 680px;
    background: var(--grigio);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 48px 40px;
    border: 1px solid rgba(184,151,58,0.08);
  }
  .heritage-bg {
    position: absolute;
    inset: 0;
    background: 
      linear-gradient(to top, rgba(8,8,8,0.95) 0%, rgba(8,8,8,0.4) 40%, transparent 70%),
      linear-gradient(135deg, #1a1008 0%, #0d0d0d 50%, #0a0505 100%);
  }
  .heritage-year-big {
    position: absolute;
    top: 30px; right: -10px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 180px;
    color: rgba(184,151,58,0.05);
    line-height: 1;
    letter-spacing: -4px;
  }
  .heritage-line {
    width: 40px; height: 2px;
    background: var(--rosso);
    margin-bottom: 20px;
  }
  .heritage-label {
    font-size: 9px;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: var(--oro);
    margin-bottom: 12px;
  }
  .heritage-copy {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(22px, 3vw, 36px);
    font-weight: 300;
    line-height: 1.35;
    color: var(--bianco);
  }
  .heritage-copy em {
    color: var(--oro);
    font-style: italic;
  }
  .heritage-sub {
    margin-top: 20px;
    font-size: 10px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: rgba(240,237,232,0.3);
  }
  .heritage-flag {
    display: flex;
    gap: 3px;
    margin-bottom: 20px;
  }
  .flag-bar {
    height: 2px;
    flex: 1;
    border-radius: 2px;
  }

  /* ── DOS COLUMNAS ── */
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  /* ── PIEZA 3: CLOSE-UP TÉCNICO ── */
  .card-tecnico {
    aspect-ratio: 1/1;
    background: #080808;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: 32px;
    border: 1px solid rgba(184,151,58,0.08);
  }
  .tecnico-circle {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 260px; height: 260px;
    border-radius: 50%;
    border: 1px solid rgba(200,16,46,0.12);
    box-shadow: inset 0 0 60px rgba(200,16,46,0.05), 0 0 80px rgba(200,16,46,0.04);
  }
  .tecnico-circle-2 {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 180px; height: 180px;
    border-radius: 50%;
    border: 1px solid rgba(184,151,58,0.08);
  }
  .tecnico-icon {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
  }
  .tecnico-icon .icon-label {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 60px;
    color: rgba(200,16,46,0.15);
    letter-spacing: 2px;
    line-height: 1;
  }
  .tecnico-icon .icon-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 11px;
    letter-spacing: 6px;
    color: var(--oro);
    text-transform: uppercase;
    margin-top: 4px;
  }
  .tecnico-content { position: relative; z-index: 2; }
  .tecnico-brand {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(28px, 3vw, 42px);
    color: var(--bianco);
    letter-spacing: 3px;
    line-height: 1;
  }
  .tecnico-copy {
    font-size: 10px;
    letter-spacing: 3px;
    color: rgba(240,237,232,0.35);
    text-transform: uppercase;
    margin-top: 6px;
  }
  .tecnico-copy span { color: var(--rosso); }

  /* ── PIEZA 4: TERRITORIO ── */
  .card-territorio {
    aspect-ratio: 1/1;
    background: #0a0a0a;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: 32px;
    border: 1px solid rgba(184,151,58,0.08);
  }
  .territorio-mountain {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(8,8,8,0.9) 0%, rgba(8,8,8,0.2) 50%, rgba(8,8,8,0.7) 100%);
  }
  .territorio-road {
    position: absolute;
    bottom: 0; left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 50%;
    background: linear-gradient(to top, rgba(184,151,58,0.4), transparent);
  }
  .territorio-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(184,151,58,0.06) 1px, transparent 1px);
    background-size: 28px 28px;
  }
  /* Stylized mountain SVG */
  .territorio-svg {
    position: absolute;
    bottom: 30%;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    opacity: 0.08;
  }
  .territorio-content {
    position: relative;
    z-index: 2;
  }
  .territorio-eyebrow {
    font-size: 9px;
    letter-spacing: 5px;
    color: var(--oro);
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .territorio-copy {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(20px, 2.5vw, 30px);
    font-weight: 300;
    line-height: 1.3;
    color: var(--bianco);
    font-style: italic;
  }
  .territorio-copy strong {
    font-style: normal;
    color: var(--rosso);
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.4em;
    letter-spacing: 2px;
    display: block;
    line-height: 1;
  }

  /* ── PIEZA 5: REEL COTOPAXI ── */
  .card-cotopaxi {
    aspect-ratio: 9/16;
    max-height: 680px;
    background: #0d0d0d;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 40px 36px;
    border: 1px solid rgba(184,151,58,0.08);
  }
  .cotopaxi-gradient {
    position: absolute;
    inset: 0;
    background: 
      linear-gradient(to top, rgba(8,8,8,1) 0%, rgba(8,8,8,0.5) 35%, rgba(8,8,8,0.1) 60%, rgba(8,8,8,0.7) 100%);
  }
  /* Stylized landscape */
  .cotopaxi-scene {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
  }
  .cotopaxi-mountain-shape {
    position: absolute;
    bottom: 30%;
    left: 50%;
    transform: translateX(-50%);
  }
  .rider-shadow {
    position: absolute;
    bottom: 20%;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    opacity: 0.6;
  }
  .cotopaxi-top { position: relative; z-index: 2; }
  .cotopaxi-logo-small {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .cotopaxi-logo-small span {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 13px;
    letter-spacing: 3px;
    color: var(--oro);
  }
  .cotopaxi-bottom { position: relative; z-index: 2; }
  .cotopaxi-years {
    font-size: 10px;
    letter-spacing: 4px;
    color: rgba(184,151,58,0.6);
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .cotopaxi-headline {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(38px, 5vw, 58px);
    line-height: 0.95;
    letter-spacing: 2px;
    color: var(--bianco);
  }
  .cotopaxi-headline span { color: var(--rosso); display: block; }
  .cotopaxi-sub {
    margin-top: 16px;
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(14px, 1.8vw, 20px);
    font-style: italic;
    color: rgba(240,237,232,0.55);
    line-height: 1.5;
  }
  .cotopaxi-pronto {
    margin-top: 28px;
    display: inline-block;
    border: 1px solid rgba(200,16,46,0.5);
    padding: 8px 20px;
    font-size: 10px;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: var(--rosso);
  }

  /* ── PIEZA 6: CIERRE REVEAL ── */
  .card-reveal {
    aspect-ratio: 16/9;
    background: var(--nero);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    border: 1px solid rgba(184,151,58,0.08);
  }
  .reveal-left {
    flex: 1;
    padding: 60px 48px;
    position: relative;
    z-index: 2;
    border-right: 1px solid rgba(184,151,58,0.08);
  }
  .reveal-right {
    flex: 1;
    padding: 60px 48px;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
  }
  .reveal-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 70% 50%, rgba(200,16,46,0.06) 0%, transparent 60%);
  }
  .reveal-number {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(80px, 12vw, 160px);
    line-height: 1;
    color: rgba(200,16,46,0.08);
    position: absolute;
    right: -10px; top: 50%;
    transform: translateY(-50%);
    letter-spacing: -4px;
    pointer-events: none;
  }
  .reveal-eyebrow {
    font-size: 9px;
    letter-spacing: 5px;
    color: var(--oro);
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .reveal-headline {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(36px, 4.5vw, 64px);
    line-height: 0.95;
    color: var(--bianco);
    letter-spacing: 2px;
  }
  .reveal-headline .red { color: var(--rosso); }
  .reveal-body {
    margin-top: 20px;
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(14px, 1.5vw, 20px);
    font-style: italic;
    color: rgba(240,237,232,0.5);
    line-height: 1.6;
    max-width: 320px;
  }
  .reveal-date-label {
    font-size: 9px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: rgba(240,237,232,0.3);
    margin-bottom: 8px;
  }
  .reveal-date {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(24px, 3vw, 40px);
    color: var(--oro);
    letter-spacing: 4px;
  }
  .reveal-cta {
    margin-top: 28px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 9px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--bianco);
    border-bottom: 1px solid rgba(200,16,46,0.4);
    padding-bottom: 4px;
  }
  .reveal-cta::after {
    content: '→';
    color: var(--rosso);
  }
  .reveal-hashtags {
    position: absolute;
    bottom: 24px; right: 24px;
    font-size: 9px;
    letter-spacing: 2px;
    color: rgba(240,237,232,0.15);
    text-align: right;
    line-height: 1.8;
  }

  /* ── CAPTION BLOCK ── */
  .caption-block {
    margin-top: 12px;
    display: flex;
    align-items: flex-start;
    gap: 20px;
    padding: 16px 20px;
    border-left: 2px solid var(--rosso);
    background: rgba(200,16,46,0.04);
  }
  .caption-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 32px;
    color: rgba(200,16,46,0.3);
    line-height: 1;
    min-width: 28px;
  }
  .caption-text { flex: 1; }
  .caption-title {
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--oro);
    margin-bottom: 4px;
  }
  .caption-desc {
    font-family: 'Cormorant Garamond', serif;
    font-size: 15px;
    font-style: italic;
    color: rgba(240,237,232,0.5);
    line-height: 1.5;
  }

  /* ── STRATEGY STRIP ── */
  .strategy-strip {
    margin: 80px 40px;
    padding: 48px;
    border: 1px solid rgba(184,151,58,0.12);
    background: rgba(184,151,58,0.02);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  .strategy-item {}
  .strategy-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 48px;
    color: rgba(200,16,46,0.2);
    line-height: 1;
    margin-bottom: 8px;
  }
  .strategy-label {
    font-size: 9px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--oro);
    margin-bottom: 8px;
  }
  .strategy-desc {
    font-family: 'Cormorant Garamond', serif;
    font-size: 15px;
    font-style: italic;
    color: rgba(240,237,232,0.45);
    line-height: 1.5;
  }
  .strategy-divider {
    width: 1px;
    background: rgba(184,151,58,0.1);
    align-self: stretch;
  }

  /* ── FOOTER ── */
  .footer-strip {
    padding: 40px 48px;
    border-top: 1px solid rgba(184,151,58,0.08);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .footer-brand {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--oro);
    opacity: 0.5;
  }
  .footer-copy {
    font-size: 9px;
    letter-spacing: 3px;
    color: rgba(240,237,232,0.15);
    text-transform: uppercase;
  }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }

